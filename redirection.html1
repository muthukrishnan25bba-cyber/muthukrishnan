<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting...</title>

    <!-- Redirect after 3 seconds -->
    <meta http-equiv="refresh" content="3;url=https://www.instagram.com/">
</head>
<body>
    <h2>Redirecting to Instagram...</h2>
    <p>If you are not redirected automatically, click the link below:</p>

    <p>
        <a href="https://www.instagram.com/">Go to Instagram</a>
    </p>
</body>
</html>
